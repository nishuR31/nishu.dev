{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": " next dev",
    "preview": "next start",
    "next": "next dev",
    "build": "rm -rf .next && next build",
    "start": "bun run build && next start",
    "lint": "eslint .",
    "format": "bunx prettier --write .",
    "sitemap": "bun scripts/generate-sitemap.js",
    "lighthouse": "bunx lighthouse https://nishudevportfolio.vercel.app --output html --output-path ./lighthouse-report.html --chrome-flags='--headless'",
    "convert-images": "bun scripts/convert-images-to-avif.js",
    "generate-lanyard": "bun scripts/generate-lanyard-assets.mjs",
    "quick-analytics": "bash scripts/quick-analytics.sh",
    "pagespeed": "PAGESPEED_KEY=YOUR_KEY npm run quick-analytics -- https://nishudevportfolio.vercel.app"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "nextjs-toploader": "^3.9.17",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "^9.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.187.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "16.4.5",
    "postcss": "^8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14"
  },
