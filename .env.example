# Queue + Redis
REDIS_URL=redis://default:password@host:6379

# Nodemailer (Gmail app password)
MAIL_USER=yourgmail@gmail.com
MAIL_APP_PASSWORD=your-16-char-app-password
MAIL_TO=yourgmail@gmail.com

# Optional worker heartbeat tuning
MAIL_WORKER_HEARTBEAT_KEY=system:mail-worker:heartbeat
MAIL_WORKER_STALE_MS=30000
